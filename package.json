{
  "name": "thinktron83",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "dev": "yarn build:wasm && vite",
    "build": "yarn build:wasm && tsc && vite build",
    "build:wasm": "for dir in wasm/*/; do name=$(basename \"$dir\"); (cd \"$dir\" && wasm-pack build --target web --out-dir \"../../public/fs/bin/$name\"); done",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
